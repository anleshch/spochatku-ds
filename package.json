{
  "name": "@spochatku/ds",
  "private": true,
  "version": "0.3.1",
  "description": "Spochatku UX design system: React components and design tokens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anleshch/spochatku-ds.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/types/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "node scripts/build-tokens.mjs",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.57.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.81.0",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.2",
    "storybook-addon-pseudo-states": "^10.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "latest"
  }
}
